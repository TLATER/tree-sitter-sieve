{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "sieve",
      "camelcase": "Sieve",
      "title": "Sieve",
      "scope": "source.sieve",
      "file-types": [
        "siv",
        "sieve"
      ],
      "injection-regex": "^sieve$",
      "class-name": "TreeSitterSieve"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Tree-sitter grammar for the Sieve e-mail filtering language",
    "authors": [
      {
        "name": "Tristan Daniel Maat"
      }
    ],
    "links": {
      "repository": "https://github.com/tree-sitter/tree-sitter-sieve"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}
